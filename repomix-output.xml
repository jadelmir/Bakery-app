    @media (max-width: 980px) {
      .flow {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .flow::before {
        display: none;
      }
    }

    @media (max-width: 680px) {
      .page {
        width: min(100% - 20px, 1180px);
        padding-top: 24px;
      }

      .hero {
        grid-template-columns: 1fr;
      }

      .release {
        justify-self: start;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .chart-head,
      .detail,
      .foundation {
        grid-template-columns: 1fr;
      }

      .chart-head {
        align-items: flex-start;
