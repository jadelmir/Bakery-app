<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bakery App — Product Flow</title>
  <style>
    :root {
      color-scheme: light;
      --canvas: #f6efe5;
      --surface: rgba(255, 252, 246, 0.92);
      --surface-strong: #fffaf2;
      --ink: #30251d;
      --muted: #78695d;
      --line: #d8c8b9;
      --brand: #a64f2a;
      --brand-soft: #f4d6c3;
      --green: #3e7356;
      --green-soft: #dbeadf;
      --gold: #b67920;
      --gold-soft: #f6e6be;
      --blue: #486c78;
      --blue-soft: #dce9ec;
      --shadow: 0 22px 60px rgba(68, 43, 24, 0.12);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-width: 320px;
      background:
        radial-gradient(circle at 8% 8%, rgba(191, 123, 69, 0.14), transparent 31rem),
        radial-gradient(circle at 94% 20%, rgba(62, 115, 86, 0.10), transparent 29rem),
        var(--canvas);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    button {
      font: inherit;
    }

    .page {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
      padding: 38px 0 48px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
      align-items: end;
      margin-bottom: 24px;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    h1 {
      max-width: 720px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.25rem, 5vw, 4.6rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 0.98;
    }

    .subtitle {
      max-width: 650px;
      margin: 16px 0 0;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.65;
    }

    .release {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      padding: 9px 12px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
      color: var(--muted);
      white-space: nowrap;
    }

    .release::before {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      content: "";
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .stat {
      padding: 17px 19px;
      border: 1px solid rgba(166, 79, 42, 0.13);
      border-radius: 18px;
      background: var(--surface);
      box-shadow: 0 10px 30px rgba(68, 43, 24, 0.05);
    }

    .stat-value {
      display: block;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.65rem;
      line-height: 1;
    }

    .stat-label {
      display: block;
      margin-top: 6px;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .chart-shell {
      overflow: hidden;
      border: 1px solid rgba(101, 74, 54, 0.16);
      border-radius: 26px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .chart-head {
      display: flex;
      gap: 18px;
      align-items: center;
      justify-content: space-between;
      padding: 20px 22px;
      border-bottom: 1px solid var(--line);
    }

    .chart-title {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.3rem;
      font-weight: 500;
    }

    .legend {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 0.78rem;
    }

    .legend span {
      display: inline-flex;
      gap: 6px;
      align-items: center;
    }

    .legend i {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--green);
    }

    .legend span:last-child i {
      background: var(--gold);
    }

    .flow {
      position: relative;
