    .detail {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.6fr);
      gap: 22px;
      min-height: 150px;
      padding: 22px;
      border-top: 1px solid var(--line);
      background: linear-gradient(135deg, rgba(244, 214, 195, 0.32), rgba(219, 234, 223, 0.28));
    }

    .detail-kicker {
      margin: 0 0 7px;
      color: var(--brand);
      font-size: 0.73rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .detail h2 {
      margin: 0 0 8px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.5rem;
      font-weight: 500;
    }

    .detail-copy {
      max-width: 680px;
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .detail-meta {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: flex-start;
      justify-content: center;
    }

    .pill {
      display: inline-flex;
      gap: 7px;
      align-items: center;
      padding: 7px 10px;
      border-radius: 999px;
      background: var(--green-soft);
      color: var(--green);
      font-size: 0.77rem;
      font-weight: 700;
    }

    .pill.next {
      background: var(--gold-soft);
      color: #785010;
    }

    .foundation {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 16px;
      align-items: center;
      padding: 18px 22px;
