      border-radius: 50%;
      background: var(--green-soft);
      color: var(--green);
      font-size: 0.78rem;
      font-weight: 700;
    }

    .node h3 {
      margin: 0 0 7px;
      font-size: 0.95rem;
      font-weight: 700;
    }

    .node p {
      margin: 0;
      color: var(--muted);
      font-size: 0.77rem;
      line-height: 1.45;
