# ==============================================================================
# Bakery App Environment Configuration Template (.env.example)
# ==============================================================================
# DO NOT ADD REAL SECRETS OR PRODUCTION CREDENTIALS TO THIS FILE.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to Browser via Vite)
# ------------------------------------------------------------------------------
# MUST begin with VITE_. Safe to embed in frontend assets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhYmdj...
VITE_SUPABASE_ANON_KEY=eyJhYmdj...
VITE_APP_URL=http://localhost:5173
VITE_ENVIRONMENT=local

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER-ONLY SECRETS (NEVER expose to frontend or commit to Git)
# ------------------------------------------------------------------------------
# DO NOT prefix with VITE_. Use ONLY in Edge Functions, CI/CD, or server tools.

# Supabase Admin / Service Role Key (Bypasses Row Level Security - KEEP SECRET!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Postgres Database Master Password (Used for migrations & admin access)
DATABASE_PASSWORD=your_database_password_here

# Resend API Key for Transactional Emails
RESEND_API_KEY=re_123456789_your_resend_api_key_here

# Supabase Management API Access Token (Used in CI/CD GitHub Actions)
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_access_token_here

# ------------------------------------------------------------------------------
# 3. CI/CD PROJECT REFERENCES (GitHub Secrets for Staging & Production)
# ------------------------------------------------------------------------------
STAGING_PROJECT_REF=your_staging_project_reference_id
PRODUCTION_PROJECT_REF=your_production_project_reference_id
