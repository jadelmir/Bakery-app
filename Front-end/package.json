{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "supabase:migrations": "supabase migration list --local",
    "supabase:migrations:linked": "supabase migration list --linked",
    "supabase:push:dry-run": "supabase db push --linked --dry-run",
    "supabase:reset": "supabase db reset --local",
    "supabase:verify-seed": "node scripts/verify-local-bakery-seed.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:types": "node scripts/generate-database-types.mjs",
    "supabase:types:check": "node scripts/generate-database-types.mjs --check",
    "supabase:types:check:linked": "node scripts/generate-database-types.mjs --linked --check",
    "openspec:validate": "openspec validate --all --strict --no-interactive",
    "test": "vitest run",
    "test:db:concurrency": "node scripts/test-workspace-concurrency.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
